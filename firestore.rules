rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCaregiverOf(seniorId) {
      return isAuthenticated() && (
        request.auth.token.role == 'caregiver' ||
        get(/databases/$(database)/documents/users/$(seniorId)).data.emergencyContacts.hasAny([request.auth.uid])
      );
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow delete: if isAdmin();

      // Long-term conversation memories (Privacy Shield: Only senior or admin can access)
      match /memories/{memoryId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Daily check-ins subcollection
      match /checkIns/{checkInId} {
        allow read: if isOwner(userId) || (
          isCaregiverOf(userId) &&
          get(/databases/$(database)/documents/users/$(userId)).data.privacySettings.shareWellnessWithCaregiver == true
        ) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Exercise activity logs
      match /exerciseLogs/{logId} {
        allow read: if isOwner(userId) || (
          isCaregiverOf(userId) &&
          get(/databases/$(database)/documents/users/$(userId)).data.privacySettings.shareExercisesWithCaregiver == true
        ) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Digital learning progress
      match /learningProgress/{progressId} {
        allow read: if isOwner(userId) || (
          isCaregiverOf(userId) &&
          get(/databases/$(database)/documents/users/$(userId)).data.privacySettings.shareLearningProgress == true
        ) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Emergency alerts log
      match /emergencyAlerts/{alertId} {
        allow read: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
        allow create: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
        allow update: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Top-level emergency assistance and notification tracking
    match /emergencyRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // RAG Knowledge Base articles (Public read for grounded AI tutorials, Admin managed)
    match /ragDocuments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System audit & security event logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Public guides and courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
